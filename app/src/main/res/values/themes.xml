<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GuppyMarketIDN" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/guppy_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:textColorPrimary">@color/guppy_text_black</item>
        <item name="android:textColorSecondary">@color/guppy_text_gray</item>
        <item name="android:windowBackground">@color/guppy_background</item>
    </style>

    <style name="Theme.GuppyMarketIDN" parent="Base.Theme.GuppyMarketIDN" />

    <style name="CircleImageStyle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <style name="TopRoundedCardStyle">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Hides the active indicator background on BottomNavigationView -->
    <style name="App.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>