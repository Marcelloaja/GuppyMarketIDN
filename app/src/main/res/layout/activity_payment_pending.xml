<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".menuHome.PaymentPendingActivity">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarPaymentPending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackPaymentPending"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:text="Pembayaran"
            android:textColor="@color/guppy_text_black"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/topBarPaymentPending"
        android:background="#EEEEEE"/>

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader"
        android:layout_above="@id/bottomBarPaymentPendingActions"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="30dp">

            <!-- 1. WAITING FOR PAYMENT STATUS HEADER CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="#E0F2F1"
                        android:src="@drawable/ic_info"
                        app:tint="@color/guppy_primary"
                        android:padding="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="Menunggu Pembayaran"
                        android:textColor="@color/guppy_text_black"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="Selesaikan pembayaran sebelum batas waktu berakhir"
                        android:textColor="@color/guppy_text_gray"
                        android:textSize="12.5sp"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tvOrderNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_bold"
                        android:text="Nomor Pesanan #GM-20931"
                        android:textColor="@color/guppy_primary"
                        android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. COUNTDOWN TIMER CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="BAYAR SEBELUM"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.05"/>

                        <TextView
                            android:id="@+id/tvPaymentDeadlineDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kamis, 24 Juli 2025 · 23:59 WIB"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <!-- Countdown Boxes Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- Hours Box -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="60dp"
                            android:layout_height="54dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeWidth="0dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvTimerHours"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="23"
                                    android:textColor="@color/guppy_primary"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="18sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="JAM"
                                    android:textColor="@color/guppy_text_gray"
                                    android:fontFamily="@font/inter_medium"
                                    android:textSize="9.5sp"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:text=":"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="20sp"/>

                        <!-- Minutes Box -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="60dp"
                            android:layout_height="54dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeWidth="0dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvTimerMinutes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="45"
                                    android:textColor="@color/guppy_primary"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="18sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MENIT"
                                    android:textColor="@color/guppy_text_gray"
                                    android:fontFamily="@font/inter_medium"
                                    android:textSize="9.5sp"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="8dp"
                            android:text=":"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="20sp"/>

                        <!-- Seconds Box -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="60dp"
                            android:layout_height="54dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeWidth="0dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvTimerSeconds"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="12"
                                    android:textColor="@color/guppy_primary"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="18sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DETIK"
                                    android:textColor="@color/guppy_text_gray"
                                    android:fontFamily="@font/inter_medium"
                                    android:textSize="9.5sp"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. VIRTUAL ACCOUNT / PAYMENT DETAILS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvBankBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_selected"
                            android:backgroundTint="#E0F2F1"
                            android:text="BCA"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="12sp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"/>

                        <TextView
                            android:id="@+id/tvPaymentMethodTitle"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Bank BCA Virtual Account"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <!-- VA Number Box -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F8F9FA"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:padding="14dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="NOMOR VIRTUAL ACCOUNT"
                                    android:textColor="@color/guppy_text_gray"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="10.5sp"
                                    android:letterSpacing="0.05"/>

                                <TextView
                                    android:id="@+id/tvVirtualAccountNumber"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="3901 0812 3456 7890"
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="16sp"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/btnCopyVaNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_chip_selected"
                                android:backgroundTint="#E0F2F1"
                                android:text="Salin"
                                android:textColor="@color/guppy_primary"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="12.5sp"
                                android:gravity="center"
                                android:paddingHorizontal="14dp"
                                android:clickable="true"
                                android:focusable="true"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="14dp" android:background="#EEEEEE"/>

                    <!-- Total Transfer Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL TRANSFER"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="10.5sp"
                                android:letterSpacing="0.05"/>

                            <TextView
                                android:id="@+id/tvTotalTransferAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 577.000"
                                android:textColor="@color/guppy_primary"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="17sp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnCopyTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_btn_outline_pill_gray"
                            android:text="Salin nominal"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. CARA PEMBAYARAN STEPS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CARA PEMBAYARAN"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"/>

                    <!-- Step 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circle_image"
                            android:backgroundTint="#E0F2F1"
                            android:text="1"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Buka aplikasi M-Banking Anda atau akses ATM terdekat."
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <!-- Step 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circle_image"
                            android:backgroundTint="#E0F2F1"
                            android:text="2"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Pilih menu Transfer, lalu pilih Virtual Account / Pembayaran."
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <!-- Step 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circle_image"
                            android:backgroundTint="#E0F2F1"
                            android:text="3"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:gravity="center"/>
                        <TextView
                            android:id="@+id/tvStep3Instruction"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Masukkan nomor Virtual Account 3901 0812 3456 7890."
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                    <!-- Step 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_circle_image"
                            android:backgroundTint="#E0F2F1"
                            android:text="4"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Periksa detail transaksi, konfirmasi nama merchant dan nominal, lalu masukkan PIN Anda untuk menyelesaikan pembayaran."
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="12.5sp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 5. PRODUCT & PAYMENT SUMMARY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_image_gallery"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPendingProductName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Red Dragon Delta"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="15sp"/>

                            <TextView
                                android:id="@+id/tvPendingProductSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="2 pasang · Setara 4 ekor"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12.5sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="14dp" android:background="#EEEEEE"/>

                    <!-- Subtotal Produk -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Subtotal produk"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvPendingSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 550.000"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Ongkos Kirim -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Ongkos kirim"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvPendingShipping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 25.000"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <!-- Biaya Layanan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Biaya layanan"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvPendingServiceFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 2.000"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#EEEEEE"/>

                    <!-- Total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Total"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="14.5sp"/>
                        <TextView
                            android:id="@+id/tvPendingTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 577.000"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="15sp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Shield Guarantee Notice Box -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F8F9FA"
                app:strokeColor="#C8E6C9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_verified_badge"
                        app:tint="#2E7D32"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Garansi sehat 24 jam berlaku setelah pesanan dikirim dan diterima dengan baik."
                        android:textColor="#2E7D32"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="11.5sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Link Change Payment Method -->
            <TextView
                android:id="@+id/btnChangePaymentMethod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:text="Ubah metode pembayaran"
                android:textColor="@color/guppy_primary"
                android:fontFamily="@font/inter_bold"
                android:textSize="13.5sp"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- STICKY BOTTOM ACTION BUTTON -->
    <LinearLayout
        android:id="@+id/bottomBarPaymentPendingActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="12dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/btnCheckPaymentStatus"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#124332"
            android:text="Cek status pembayaran"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</RelativeLayout>