<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chip_outline"
        android:backgroundTint="@color/guppy_stroke"/>

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Pilih Aplikasi Peta"
            android:textColor="@color/guppy_text_black"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btnCloseMapChoice"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_image"
            android:backgroundTint="#F0F0F0"
            android:src="@drawable/fi_rr_cross_small"
            android:padding="6dp"
            app:tint="@color/guppy_text_black"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:text="Pilih peta dalam aplikasi atau navigasi GPS eksternal"
        android:textColor="@color/guppy_text_gray"
        android:textSize="12sp" />

    <!-- Option 1: MapLibre GL + OpenStreetMap (In-App GuppyMarket) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnChoiceInAppMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F8F9FA"
        app:strokeColor="@color/guppy_stroke"
        app:strokeWidth="1dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_image"
                android:backgroundTint="#E8F5E9"
                android:src="@drawable/ic_map_fill"
                android:padding="10dp"
                app:tint="@color/guppy_primary"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Peta GuppyMarket (MapLibre)"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="OpenStreetMap interaktif di dalam aplikasi"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"/>
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/guppy_text_gray"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Option 2: Google Maps External -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnChoiceGoogleMaps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F8F9FA"
        app:strokeColor="@color/guppy_stroke"
        app:strokeWidth="1dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_image"
                android:backgroundTint="#FFF3E0"
                android:src="@drawable/ic_location_pin"
                android:padding="10dp"
                app:tint="#E65100"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Google Maps (GPS Navigasi)"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Navigasi suara &amp; rute berkendara eksternal"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"/>
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/guppy_text_gray"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>