<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".menuProfile.ShippingAddressActivity">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarShippingAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackShippingAddress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Alamat Pengiriman"
                android:textColor="@color/guppy_text_black"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_regular"
                android:text="Atur tujuan pengiriman ikan untuk pesanan Anda"
                android:textColor="@color/guppy_text_gray"
                android:textSize="12.5sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/topBarShippingAddress"
        android:background="#EEEEEE"/>

    <!-- SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader"
        android:layout_above="@id/bottomBarAddAddress"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="30dp">

            <!-- Default Address Info Banner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EBF6F0"
                app:strokeColor="#C8E6C9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_info"
                        app:tint="#2E7D32"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Alamat utama dipakai sebagai default saat checkout dan pengiriman kurir."
                        android:textColor="#2E7D32"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION 1: ALAMAT TERSIMPAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="ALAMAT TERSIMPAN"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="11.5sp"
                    android:letterSpacing="0.05"/>

                <TextView
                    android:id="@+id/tvTotalAddressCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 alamat"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12.5sp"/>
            </LinearLayout>

            <!-- RecyclerView Address Cards -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerShippingAddresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"/>

            <!-- SECTION 2: CATATAN PENGIRIMAN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CATATAN PENGIRIMAN"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_bold"
                android:textSize="11.5sp"
                android:letterSpacing="0.05"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Catatan untuk kurir (opsional)"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etCourierNotes"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@null"
                        android:hint="Contoh: Rumah pagar hijau, dekat warung"
                        android:textColorHint="@color/guppy_text_gray"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:singleLine="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- STICKY BOTTOM ACTION BAR -->
    <LinearLayout
        android:id="@+id/bottomBarAddAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="12dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/btnAddNewAddress"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#00897B"
            android:text="+ Tambah Alamat Baru"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</RelativeLayout>