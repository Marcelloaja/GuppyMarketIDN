<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshHub"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ui.Community">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingBottom="100dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:text="Hub"
                        android:textColor="@color/guppy_text_black"
                        android:textSize="26sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter_regular"
                        android:text="Komunitas pembeli dan farm guppy"
                        android:textColor="@color/guppy_text_gray"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circle_image"
                    android:backgroundTint="#E8F5E9"
                    android:src="@drawable/search"
                    app:tint="@color/guppy_primary"
                    android:padding="10dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="#E8F5E9"
                        android:src="@drawable/ic_leaf"
                        app:tint="@color/guppy_primary"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"/>
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="@color/guppy_red"/>
                </FrameLayout>
            </LinearLayout>

            <!-- TABS SEGMENTED -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_vehicle_segment_container"
                    android:backgroundTint="#EDEDED"
                    android:padding="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_vehicle_active_pill"
                        android:text="Semua"
                        android:textColor="@color/guppy_primary"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="13sp"
                        android:paddingHorizontal="24dp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:text="Video"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="13sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:text="Foto"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="13sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:text="Tanya Jawab"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="13sp"
                        android:paddingHorizontal="20dp"
                        android:gravity="center"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- LELANG MALAM INI SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lelang malam ini"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="15sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat semua"
                    android:textColor="@color/guppy_primary"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- LELANG CARDS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Promo Card 1 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="@color/guppy_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_photo_count"
                                android:backgroundTint="#00E676"
                                android:text="HOT PROMO"
                                android:textColor="@color/white"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="9sp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Diskon Spesial\nFarm Jakarta"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="16sp"
                                android:lineSpacingExtra="2dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Hingga 50% untuk Albino"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Promo Card 2 -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="@color/guppy_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_photo_count"
                                android:backgroundTint="#00E676"
                                android:text="HOT PROMO"
                                android:textColor="@color/white"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="9sp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Diskon Spesial\nFarm Jakarta"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="16sp"
                                android:lineSpacingExtra="2dp"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="Hingga 50% untuk Albino"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- CREATE POST CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/marcello"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/CircleImageStyle"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_chip_outline"
                            android:backgroundTint="#F8F9FA"
                            android:text="Bagikan update guppy kamu..."
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_outline"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:layout_marginEnd="8dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_image_gallery"
                                app:tint="@color/guppy_primary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Foto"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_semi_bold"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_outline"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:layout_marginStart="8dp"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_video_camera"
                                app:tint="@color/guppy_primary"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Video"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_semi_bold"
                                android:textSize="13sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FEED POST 1: IMAGE -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/logofinfantasyfarm"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/CircleImageStyle"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Java Guppy Farm"
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="14sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_tag_photo_count"
                                    android:backgroundTint="#E8F5E9"
                                    android:text="Terverifikasi"
                                    android:textColor="@color/guppy_primary"
                                    android:fontFamily="@font/inter_semi_bold"
                                    android:textSize="10sp"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="2 jam lalu"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="16dp"
                        android:text="Indukan Mosaic Genetik murni siap lelang malam ini di Hub! Cek detailnya di bawah."
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_image_grid"
                            android:scaleType="centerCrop"
                            app:cornerSize="12dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_tag_photo_count"
                            android:backgroundTint="#80000000"
                            android:text="MOSAIC"
                            android:textColor="@color/white"
                            android:fontFamily="@font/inter_semi_bold"
                            android:textSize="10sp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:letterSpacing="0.05"/>
                    </FrameLayout>

                    <!-- Post Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/fi_ss_heart_full"
                            app:tint="@color/guppy_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="124"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="13sp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_comment_bubble"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="14"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="13sp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_share"
                            app:tint="#757575"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_bookmark_outline"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/guppy_stroke"/>

                    <!-- Comments Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FAFAFA">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/bg_detail"
                                android:scaleType="centerCrop"
                                app:shapeAppearanceOverlay="@style/CircleImageStyle"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Ani Guppy"
                                        android:textColor="@color/guppy_text_black"
                                        android:fontFamily="@font/inter_bold"
                                        android:textSize="12sp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="Pembeli"
                                        android:textColor="@color/guppy_text_gray"
                                        android:fontFamily="@font/inter_regular"
                                        android:textSize="10sp"/>
                                </LinearLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Cek harga indukannya gan."
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="12sp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Balas"
                                    android:textColor="@color/guppy_primary"
                                    android:fontFamily="@font/inter_semi_bold"
                                    android:textSize="11sp"/>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="36dp"
                            android:layout_marginTop="12dp"
                            android:text="Lihat 12 balasan lainnya"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_semi_bold"
                            android:textSize="12sp"/>

                        <!-- Input Comment -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:orientation="horizontal"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical">

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_chip_outline"
                                android:backgroundTint="@color/white"
                                android:hint="Tulis balasan..."
                                android:textColorHint="@color/guppy_text_gray"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"
                                android:paddingHorizontal="16dp"
                                android:layout_marginEnd="12dp"/>

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_circle_image"
                                android:backgroundTint="@color/guppy_primary">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_send_plane"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FEED POST 2: VIDEO -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:gravity="center_vertical">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/marcello"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/CircleImageStyle"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Budi Santoso"
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="14sp"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_tag_photo_count"
                                    android:backgroundTint="#EEEEEE"
                                    android:text="Pembeli"
                                    android:textColor="@color/guppy_text_gray"
                                    android:fontFamily="@font/inter_semi_bold"
                                    android:textSize="10sp"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="4 jam lalu"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="16dp"
                        android:text="Proses karantina guppy baru sampai, ekornya lebar banget!"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginHorizontal="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/skyblue"
                            android:scaleType="centerCrop"
                            app:cornerSize="12dp"/>

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle_image"
                            android:backgroundTint="#60000000"
                            android:src="@drawable/ic_play"
                            android:padding="14dp"
                            app:tint="@color/white"
                            android:clickable="true"
                            android:focusable="true"/>

                        <!-- LIVE Tag -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_tag_photo_count"
                            android:backgroundTint="@color/guppy_red"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:gravity="center_vertical">
                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_circle_image"
                                android:backgroundTint="@color/white"
                                android:layout_marginEnd="4dp"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LIVE"
                                android:textColor="@color/white"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="10sp"/>
                        </LinearLayout>

                        <!-- Duration -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="12dp"
                            android:background="@drawable/bg_tag_photo_count"
                            android:backgroundTint="#B3000000"
                            android:text="0:42"
                            android:textColor="@color/white"
                            android:fontFamily="@font/inter_semi_bold"
                            android:textSize="11sp"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"/>
                    </FrameLayout>

                    <!-- Post Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="16dp"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/fi_rs_heart"
                            app:tint="#757575"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="56"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="13sp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_comment_bubble"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="8"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="13sp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="20dp"
                            android:src="@drawable/ic_share"
                            app:tint="#757575"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp"/>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_bookmark_outline"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/guppy_stroke"/>

                    <!-- Input Comment -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:background="#FAFAFA"
                        android:gravity="center_vertical">

                        <EditText
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_chip_outline"
                            android:backgroundTint="@color/white"
                            android:hint="Tulis balasan..."
                            android:textColorHint="@color/guppy_text_gray"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="12sp"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="12dp"/>

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_circle_image"
                            android:backgroundTint="@color/guppy_primary">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_send_plane"/>
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>