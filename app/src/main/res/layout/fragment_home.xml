<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/guppy_background"
    tools:context=".ui.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Decorative Ambient Glow Background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@drawable/bg_home_header_glow"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgAvatarHome"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_default_user_avatar"
                    android:scaleType="centerCrop"
                    android:padding="2dp"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle"
                    app:strokeColor="@color/guppy_primary"
                    app:strokeWidth="2dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="@color/guppy_text_gray"
                        android:text="Selamat Pagi,"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_semi_bold"
                        android:textColor="@color/guppy_text_black"
                        android:text="Marcello Aja"
                        android:textSize="16sp" />
                </LinearLayout>

                <!-- Chat Button with Red Badge -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:id="@+id/btnChatHome"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="@color/guppy_primary"
                        android:src="@drawable/ic_chat"
                        app:tint="@color/white"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true"/>
                    <View
                        android:id="@+id/dotUnreadChatHome"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="@color/guppy_red"
                        android:visibility="gone"/>
                </FrameLayout>

                <ImageView
                    android:id="@+id/btnNotifHome"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_circle_image"
                    android:backgroundTint="@color/guppy_primary"
                    android:src="@drawable/ic_notifications_black_24dp"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/white"/>

                <ImageView
                    android:id="@+id/btnCartHome"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_image"
                    android:backgroundTint="@color/guppy_primary"
                    android:src="@drawable/fi_rr_shopping_cart"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/white"/>
            </LinearLayout>

            <!-- SEARCH BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/search"
                        app:tint="@color/guppy_primary"/>

                    <EditText
                        android:id="@+id/etSearchHome"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Cari varian guppy atau nama farm..."
                        android:textColorHint="@color/guppy_text_gray"
                        android:textColor="@color/guppy_text_black"
                        android:paddingStart="12dp"
                        android:singleLine="true"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/filterHome"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_search_bar"
                    android:src="@drawable/filter"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="@color/guppy_primary"/>
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>

            <!-- CAROUSEL (HOT PROMO) -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerCarousel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-90dp"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                app:shimmer_auto_start="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/shimmer_carousel_item" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/carouselRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-90dp"
                android:clipToPadding="false"
                android:paddingHorizontal="10dp"
                android:visibility="gone" />

            <!-- KATEGORI VARIAN TITLE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semi_bold"
                    android:text="Kategori Toko"
                    android:textColor="@color/guppy_text_black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnSeeAllCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semi_bold"
                    android:text="Lihat Semua"
                    android:textColor="@color/guppy_primary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- KATEGORI VARIAN RECYCLERVIEW (DYNAMIC & SYNCED) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryHorizontalRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none"/>



            <!-- LELANG HARI INI -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semi_bold"
                            android:text="Lelang Hari Ini"
                            android:textColor="@color/guppy_text_black"
                            android:textSize="16sp" />
                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_circle_image"
                            android:backgroundTint="#4CAF50"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:text="Kesempatan dapatkan kualitas kontes"
                        android:textColor="@color/guppy_text_gray"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSeeAllHomeAuctions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="Lihat Semua"
                    android:textColor="@color/guppy_primary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- LELANG HARI INI RECYCLERVIEW (DYNAMIC & SYNCED WITH LELANG TAB) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHomeAuctions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none"/>

            <!-- EMPTY STATE FOR HOME AUCTIONS -->
            <TextView
                android:id="@+id/tvEmptyHomeAuctions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_variant_card_unselected"
                android:padding="16dp"
                android:text="Belum ada lelang aktif saat ini. Buka menu Lelang untuk membuat lelang baru!"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_medium"
                android:textSize="12.5sp"
                android:gravity="center"
                android:visibility="gone"/>

            <!-- FARM TERPERCAYA TERDEKAT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/inter_semi_bold"
                android:text="Farm Terpercaya Terdekat"
                android:textColor="@color/guppy_text_black"
                android:textSize="16sp" />

            <!-- RECYCLERVIEW HOME FARMS (DYNAMIC REALTIME FROM FIRESTORE) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHomeFarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_border_card"/>

            <TextView
                android:id="@+id/tvEmptyHomeFarms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_variant_card_unselected"
                android:padding="16dp"
                android:text="Belum ada farm terdaftar di sekitar lokasi Anda."
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_medium"
                android:textSize="12.5sp"
                android:gravity="center"
                android:visibility="gone"/>

            <!-- BARU DITAMBAHKAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSectionTitleGrid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semi_bold"
                    android:text="Baru Ditambahkan"
                    android:textColor="@color/guppy_text_black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnSeeAllHomeProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="Lihat Semua"
                    android:textColor="@color/guppy_primary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Grid Items (Baru Ditambahkan) loaded here from GridAdapter -->

            <!-- SHIMMER GRID -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                app:shimmer_auto_start="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <include layout="@layout/shimmer_grid_item" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <include layout="@layout/shimmer_grid_item" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <include layout="@layout/shimmer_grid_item" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">
                            <include layout="@layout/shimmer_grid_item" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gridViewRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:scrollbars="none"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/textNoData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Data not found"
                android:visibility="gone"
                android:textColor="@color/guppy_text_black"
                android:textSize="14sp" />

            <!-- TIPS PERAWATAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_semi_bold"
                    android:text="Tips Perawatan"
                    android:textColor="@color/guppy_text_black"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/btnSeeAllHomeTips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:text="Lihat Semua"
                    android:textColor="@color/guppy_primary"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <!-- Tip 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_border_card"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_image_grid"
                            android:scaleType="centerCrop"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kualitas Air"
                            android:textColor="@color/guppy_primary"
                            android:textSize="10sp"
                            android:background="@drawable/bg_tag_grade"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cara menjaga kualitas air untuk guppy kontes"
                            android:fontFamily="@font/inter_semi_bold"
                            android:textColor="@color/guppy_text_black"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕒 4 menit baca"
                            android:textSize="10sp"
                            android:textColor="@color/guppy_text_gray"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Tip 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_border_card"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/bg_image_grid"
                            android:scaleType="centerCrop"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nutrisi"
                            android:textColor="@color/guppy_orange"
                            android:textSize="10sp"
                            android:background="@drawable/bg_tag_grade"
                            android:backgroundTint="#20F06A38"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pakan terbaik agar warna ekor makin tajam"
                            android:fontFamily="@font/inter_semi_bold"
                            android:textColor="@color/guppy_text_black"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕒 3 menit baca"
                            android:textSize="10sp"
                            android:textColor="@color/guppy_text_gray"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
