<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp"
    tools:context=".menuAuction.BottomDialogBidHistory">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chip_outline"
        android:backgroundTint="@color/guppy_stroke"/>

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Riwayat Penawaran"
                android:textColor="@color/guppy_text_black"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvTotalBidCountSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="18 penawaran masuk"
                android:textColor="@color/guppy_text_gray"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnCloseBidHistory"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_image"
            android:backgroundTint="#F0F0F0"
            android:src="@drawable/fi_rr_cross_small"
            android:padding="8dp"
            app:tint="@color/guppy_text_black"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/guppy_stroke"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerBidHistoryList"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="8dp"
        android:scrollbars="vertical"/>

</LinearLayout>