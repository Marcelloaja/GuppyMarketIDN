<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <!-- Konten dibiarkan Full Screen agar Floating Nav melayang rapi di atasnya -->
    <FrameLayout
        android:id="@+id/navhost"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 100% ACCURATE FLOATING CIRCLE PILL BOTTOM NAV BAR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomNav"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="22dp"
        app:cardCornerRadius="33dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#F2F3F5"
        app:strokeWidth="0dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/nav_view"
            style="@style/Widget.MaterialComponents.BottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:menu="@menu/menu"
            app:itemIconSize="24dp"
            app:itemIconTint="@color/bottom_nav_color_circle"
            app:itemRippleColor="@color/guppy_primary_light"
            app:labelVisibilityMode="unlabeled"
            app:itemActiveIndicatorStyle="@style/App.CircleNav.Indicator"/>

    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>