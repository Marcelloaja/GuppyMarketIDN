<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".menuHome.CategoryProductsActivity">

    <!-- UNIFIED HEADER CONTAINER -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#F8F9FA"
        android:orientation="vertical">

        <!-- Top Navigation Row -->
        <LinearLayout
            android:id="@+id/topBarCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button -->
            <ImageView
                android:id="@+id/btnBackCategory"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_white_stroke"
                android:src="@drawable/ic_chevron_left"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Search Bar in Header -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/search"
                    app:tint="@color/guppy_text_gray"/>

                <EditText
                    android:id="@+id/etSearchCategoryPage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Cari di Kontes"
                    android:textColorHint="@color/guppy_text_gray"
                    android:textColor="@color/guppy_text_black"
                    android:paddingStart="10dp"
                    android:singleLine="true"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Cart Icon Overlay -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp">

                <ImageView
                    android:id="@+id/btnCartCategoryPage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_image"
                    android:backgroundTint="@color/guppy_primary"
                    android:src="@drawable/fi_rr_shopping_cart"
                    android:padding="10dp"
                    app:tint="@color/white"
                    android:clickable="true"
                    android:focusable="true"/>

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_circle_image"
                    android:backgroundTint="#FF6D00"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Category Title, Subtitle & Product Counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategoryPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Kontes"
                android:textColor="@color/guppy_text_black"
                android:textSize="24sp"/>

            <TextView
                android:id="@+id/tvCategoryPageSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_regular"
                android:text="Ikan dan perlengkapan kontes pilihan"
                android:textColor="@color/guppy_text_gray"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/tvCategoryPageCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="128 produk"
                android:textColor="@color/guppy_primary"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- SINGLE COMPACT FILTER & SORT BAR (SOLUSI A) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 1. Green Filter Button -->
                <LinearLayout
                    android:id="@+id/btnFilterOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_filter_green"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/filter"
                        app:tint="@color/white"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Filter"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="12.5sp"/>
                </LinearLayout>

                <!-- 2. Sort Terlaris -->
                <TextView
                    android:id="@+id/chipSortPopular"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_selected"
                    android:text="Terlaris"
                    android:textColor="@color/guppy_primary"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textSize="12.5sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- 3. Sort Terbaru -->
                <TextView
                    android:id="@+id/chipSortLatest"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="Terbaru"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="12.5sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- 4. Galur Dropdown Choice -->
                <TextView
                    android:id="@+id/chipFilterGalur"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="Galur: Semua ∨"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="12.5sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- 5. Harga Dropdown Choice -->
                <TextView
                    android:id="@+id/chipSortPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="Harga ∨"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="12.5sp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- PRODUCT GRID RECYCLERVIEW -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerContainer"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="60dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerCategoryProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmptyCategoryProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:gravity="center"
                android:text="Belum ada produk di kategori ini"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_medium"
                android:textSize="14sp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvLoadMoreProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:text="Memuat produk lainnya"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_regular"
                android:textSize="12sp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>