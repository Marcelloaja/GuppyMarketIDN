<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/guppy_stroke"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- IMAGE CONTAINER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_image_grid" />

            <!-- Floating Heart Button -->
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_image"
                android:backgroundTint="#CC000000"
                android:src="@drawable/fi_rs_heart"
                app:tint="@color/white"
                android:padding="8dp"
                android:scaleType="fitCenter"/>

            <!-- Grade / Badge Tag (Top Left) -->
            <ImageView
                android:id="@+id/iconGrade"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_verified_badge"/>
        </FrameLayout>

        <!-- INFO CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Sky Blue High Dorsal"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/guppy_text_black" />

            <TextView
                android:id="@+id/tvProductGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_tag_photo_count"
                android:backgroundTint="#E8F5E9"
                android:text="Grade A"
                android:textColor="@color/guppy_primary"
                android:fontFamily="@font/inter_bold"
                android:textSize="10sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Rp 150.000"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:textColor="@color/guppy_primary" />

            <TextView
                android:id="@+id/tvProductUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_photo_count"
                android:backgroundTint="#F5F5F5"
                android:text="per ekor"
                android:textSize="10sp"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_medium"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>