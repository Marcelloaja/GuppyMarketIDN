<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".menuProfile.EditAccountDetailActivity">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarEditAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackEditAccount"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvEditHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Ubah Data Rekening"
                android:textColor="@color/guppy_text_black"
                android:textSize="18sp"/>

            <TextView
                android:id="@+id/tvEditHeaderSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_regular"
                android:text="Perbarui informasi rekening penerima pencairan"
                android:textColor="@color/guppy_text_gray"
                android:textSize="12.5sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/topBarEditAccount"
        android:background="#EEEEEE"/>

    <!-- FORM SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader"
        android:layout_above="@id/bottomBarEditAccountSave"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="30dp">

            <!-- 1. INFORMASI REKENING CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INFORMASI REKENING"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"/>

                    <!-- Field 1: NAMA PEMILIK -->
                    <TextView
                        android:id="@+id/tvEditOwnerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="NAMA PEMILIK"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F8F9FA"
                        app:strokeWidth="0dp">

                        <EditText
                            android:id="@+id/etEditOwnerName"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="Marcello"
                            android:textColorHint="@color/guppy_text_gray"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:paddingHorizontal="14dp"
                            android:textSize="14sp"
                            android:singleLine="true"/>
                    </androidx.cardview.widget.CardView>

                    <!-- Field 2: NOMOR REKENING CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutEditNumberContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEditNumberLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="NOMOR REKENING"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.05"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="14dp"
                                android:orientation="horizontal">

                                <EditText
                                    android:id="@+id/etEditAccountNumber"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="match_parent"
                                    android:background="@null"
                                    android:hint="8210 4456 4821"
                                    android:textColorHint="@color/guppy_text_gray"
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="14.5sp"
                                    android:inputType="number"
                                    android:singleLine="true"/>

                                <ImageView
                                    android:id="@+id/btnCopyAccNumber"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="10dp"
                                    android:src="@drawable/ic_copy_clipboard"
                                    app:tint="@color/guppy_text_gray"
                                    android:clickable="true"
                                    android:focusable="true"/>

                                <ImageView
                                    android:id="@+id/btnClearAccNumber"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/fi_rr_cross_small"
                                    app:tint="#E53935"
                                    android:clickable="true"
                                    android:focusable="true"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- Field 3: BANK / PENYEDIA CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutEditProviderContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEditProviderLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="BANK"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.05"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:id="@+id/layoutSelectBank"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="14dp"
                                android:orientation="horizontal"
                                android:clickable="true"
                                android:focusable="true">

                                <ImageView
                                    android:id="@+id/imgEditProviderIcon"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_payment_card"
                                    app:tint="@color/guppy_primary"/>

                                <TextView
                                    android:id="@+id/tvEditBankChoice"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="BCA"
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="14sp"/>

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/guppy_text_gray"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- Field 4: JENIS REKENING CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutAccountTypeContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="JENIS REKENING"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.05"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:id="@+id/layoutSelectAccountType"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="14dp"
                                android:orientation="horizontal"
                                android:clickable="true"
                                android:focusable="true">

                                <TextView
                                    android:id="@+id/tvEditAccountTypeChoice"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content"
                                    android:text="Tabungan"
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="14sp"/>

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/guppy_text_gray"/>
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- Field 5: CABANG CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutBranchContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="CABANG"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.05"/>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeWidth="0dp">

                            <EditText
                                android:id="@+id/etEditBranch"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:hint="KCP Bandung Dago"
                                android:textColorHint="@color/guppy_text_gray"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:paddingHorizontal="14dp"
                                android:textSize="14sp"
                                android:singleLine="true"/>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- Field 6: UPLOAD QRIS CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutEditQrisUploadContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="UPLOAD FOTO BARCODE QRIS TOKO"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.05"/>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cardEditUploadQris"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginTop="6dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#F8F9FA"
                            app:strokeColor="#E2E8F0"
                            app:strokeWidth="1dp"
                            android:clickable="true"
                            android:focusable="true">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/ivEditQrisPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_qris"/>
                            </FrameLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. PENGATURAN CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PENGATURAN"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jadikan rekening utama"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="13.5sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rekening utama akan digunakan untuk penarikan otomatis."
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchEditSetMainAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:useMaterialThemeColors="true"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info Notice Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F8F9FA"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info"
                        app:tint="#2E7D32"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Perubahan nomor rekening akan diverifikasi ulang sebelum dapat digunakan untuk pencairan."
                        android:textColor="#2E7D32"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- STICKY BOTTOM ACTION BAR -->
    <LinearLayout
        android:id="@+id/bottomBarEditAccountSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="12dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelEditAccount"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_outline"
            android:text="Batal"
            android:textColor="@color/guppy_text_black"
            android:fontFamily="@font/inter_bold"
            android:textSize="14.5sp"
            android:gravity="center"
            android:layout_marginEnd="10dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnSaveEditAccount"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="48dp"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#124332"
            android:text="Simpan Perubahan"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</RelativeLayout>