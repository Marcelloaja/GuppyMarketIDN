<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".menuHome.KeranjangHome">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarKeranjang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#F8F9FA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackKeranjang"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Keranjang"
            android:textColor="@color/guppy_text_black"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarKeranjang"
        android:layout_above="@id/bottomCheckoutBar"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- SELECT ALL CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSelectAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbSelectAll"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@null"
                        android:button="@drawable/bg_checkbox_custom"
                        android:checked="true"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Pilih semua"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvSelectedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 item dipilih"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/btnDeleteSelected"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Hapus"
                        android:textColor="@color/guppy_red"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FARM PRODUCTS CONTAINER CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFarmContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Farm Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_image"
                            android:backgroundTint="#D85C42"
                            android:text="BA"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:fontFamily="@font/inter_semi_bold"
                            android:textSize="13sp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bekasi Aqua Farm"
                                    android:fontFamily="@font/inter_bold"
                                    android:textColor="@color/guppy_text_black"
                                    android:textSize="13sp"
                                    android:layout_marginEnd="6dp"/>
                                <ImageView
                                    android:layout_width="12dp"
                                    android:layout_height="12dp"
                                    android:src="@drawable/ic_verified_badge"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="TERVERIFIKASI"
                                    android:textColor="@color/guppy_primary"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="9sp"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="2dp">
                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:src="@drawable/star"
                                    app:tint="@color/guppy_star"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:text="4,8"
                                    android:fontFamily="@font/inter_semi_bold"
                                    android:textSize="11sp"
                                    android:textColor="@color/guppy_text_black"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:text="(126 ulasan)"
                                    android:textSize="11sp"
                                    android:textColor="@color/guppy_text_gray"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="·"
                                    android:textSize="11sp"
                                    android:textColor="@color/guppy_text_gray"/>
                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="4dp"
                                    android:src="@drawable/map"
                                    app:tint="@color/guppy_text_gray"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:text="Bekasi, 5,1 km"
                                    android:textSize="11sp"
                                    android:textColor="@color/guppy_text_gray"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/guppy_stroke"
                        android:layout_marginVertical="12dp"/>

                    <!-- ITEM 1 -->
                    <LinearLayout
                        android:id="@+id/layoutItem1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top">

                            <CheckBox
                                android:id="@+id/cbItem1"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@null"
                                android:button="@drawable/bg_checkbox_custom"
                                android:checked="true"
                                android:layout_gravity="center_vertical"/>

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_marginStart="10dp"
                                android:src="@drawable/bg_image_grid"
                                android:scaleType="centerCrop"
                                app:cornerSize="12dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:text="Red Dragon Delta"
                                        android:textColor="@color/guppy_text_black"
                                        android:fontFamily="@font/inter_bold"
                                        android:textSize="14sp"/>
                                    <ImageView
                                        android:id="@+id/btnDelete1"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_trash"
                                        app:tint="@color/guppy_text_gray"
                                        android:clickable="true"
                                        android:focusable="true"/>
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Jantan &amp; betina · 3–4 cm · Usia 3 bulan"
                                    android:textColor="@color/guppy_text_gray"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="11sp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_tag_photo_count"
                                    android:backgroundTint="#E8F5E9"
                                    android:text="PASANG"
                                    android:textColor="@color/guppy_primary"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="9sp"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"/>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="bottom"
                                    android:layout_marginTop="6dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Rp 275.000"
                                        android:textColor="@color/guppy_text_black"
                                        android:fontFamily="@font/inter_bold"
                                        android:textSize="14sp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="/ pasang"
                                        android:textColor="@color/guppy_text_gray"
                                        android:fontFamily="@font/inter_regular"
                                        android:textSize="11sp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 1 Bottom Stepper Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="Setara 4 ekor"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="11sp"
                                android:gravity="end"
                                android:layout_marginEnd="12dp"/>

                            <!-- Stepper 1 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:background="@drawable/bg_chip_outline"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/btnMin1"
                                    android:layout_width="30dp"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/btnmin"
                                    app:tint="@color/guppy_text_black"
                                    android:padding="8dp"
                                    android:clickable="true"
                                    android:focusable="true"/>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/guppy_stroke"/>

                                <TextView
                                    android:id="@+id/tvQty1"
                                    android:layout_width="28dp"
                                    android:layout_height="match_parent"
                                    android:text="2"
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_semi_bold"
                                    android:textSize="12sp"
                                    android:gravity="center"/>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/guppy_stroke"/>

                                <ImageView
                                    android:id="@+id/btnPlus1"
                                    android:layout_width="30dp"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/btnplus"
                                    app:tint="@color/guppy_text_black"
                                    android:padding="8dp"
                                    android:clickable="true"
                                    android:focusable="true"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:id="@+id/dividerItem1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/guppy_stroke"
                        android:layout_marginVertical="16dp"/>

                    <!-- ITEM 2 -->
                    <LinearLayout
                        android:id="@+id/layoutItem2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="top">

                            <CheckBox
                                android:id="@+id/cbItem2"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:background="@null"
                                android:button="@drawable/bg_checkbox_custom"
                                android:checked="true"
                                android:layout_gravity="center_vertical"/>

                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_marginStart="10dp"
                                android:src="@drawable/skyblue"
                                android:scaleType="centerCrop"
                                app:cornerSize="12dp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">
                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_weight="1"
                                        android:layout_height="wrap_content"
                                        android:text="Half Moon Plakat"
                                        android:textColor="@color/guppy_text_black"
                                        android:fontFamily="@font/inter_bold"
                                        android:textSize="14sp"/>
                                    <ImageView
                                        android:id="@+id/btnDelete2"
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:src="@drawable/ic_trash"
                                        app:tint="@color/guppy_text_gray"
                                        android:clickable="true"
                                        android:focusable="true"/>
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Jantan · 4–5 cm · Usia 4 bulan"
                                    android:textColor="@color/guppy_text_gray"
                                    android:fontFamily="@font/inter_regular"
                                    android:textSize="11sp"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:background="@drawable/bg_tag_photo_count"
                                    android:backgroundTint="#E8F5E9"
                                    android:text="PASANG"
                                    android:textColor="@color/guppy_primary"
                                    android:fontFamily="@font/inter_bold"
                                    android:textSize="9sp"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"/>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="bottom"
                                    android:layout_marginTop="6dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Rp 137.500"
                                        android:textColor="@color/guppy_text_black"
                                        android:fontFamily="@font/inter_bold"
                                        android:textSize="14sp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:text="/ ekor"
                                        android:textColor="@color/guppy_text_gray"
                                        android:fontFamily="@font/inter_regular"
                                        android:textSize="11sp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Item 2 Bottom Stepper Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <!-- Stepper 2 -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:background="@drawable/bg_chip_outline"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/btnMin2"
                                    android:layout_width="30dp"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/btnmin"
                                    app:tint="@color/guppy_text_black"
                                    android:padding="8dp"
                                    android:clickable="true"
                                    android:focusable="true"/>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/guppy_stroke"/>

                                <TextView
                                    android:id="@+id/tvQty2"
                                    android:layout_width="28dp"
                                    android:layout_height="match_parent"
                                    android:text="1"
                                    android:textColor="@color/guppy_text_black"
                                    android:fontFamily="@font/inter_semi_bold"
                                    android:textSize="12sp"
                                    android:gravity="center"/>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="match_parent"
                                    android:background="@color/guppy_stroke"/>

                                <ImageView
                                    android:id="@+id/btnPlus2"
                                    android:layout_width="30dp"
                                    android:layout_height="match_parent"
                                    android:src="@drawable/btnplus"
                                    app:tint="@color/guppy_text_black"
                                    android:padding="8dp"
                                    android:clickable="true"
                                    android:focusable="true"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- OXYGEN PACKAGE NOTE BANNER -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardOxygenNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8F5E9"
                app:strokeColor="#C8E6C9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_box_check"
                        app:tint="@color/guppy_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Setiap pengiriman menggunakan kemasan oksigen."
                        android:textColor="#2E7D32"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SHOPPING SUMMARY CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RINGKASAN BELANJA"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tvSubtotalItemLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Subtotal (3 item)"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"/>
                        <TextView
                            android:id="@+id/tvSubtotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 550.000"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="13sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Estimasi ongkos kirim"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="13sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dihitung di checkout"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_medium"
                            android:textStyle="italic"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/guppy_stroke"
                        android:layout_marginVertical="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Total"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="15sp"/>
                        <TextView
                            android:id="@+id/tvTotalSummaryAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 550.000"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="16sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- EMPTY CART STATE -->
            <LinearLayout
                android:id="@+id/layoutEmptyCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="80dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/fi_rr_shopping_cart"
                    app:tint="@color/guppy_text_gray"
                    android:alpha="0.3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Keranjang kamu masih kosong"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Yuk, jelajahi varian guppy cantik di Beranda!"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM CHECKOUT ACTION BAR (STICKY) -->
    <LinearLayout
        android:id="@+id/bottomCheckoutBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="16dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <!-- Total Price Left -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_bold"
                android:textSize="10sp"
                android:letterSpacing="0.05"/>
            <TextView
                android:id="@+id/tvTotalHarga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 550.000"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_black"
                android:textSize="18sp"/>
            <TextView
                android:id="@+id/tvTotalSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 pasang · 6 ekor"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_regular"
                android:textSize="10sp"/>
        </LinearLayout>

        <!-- Checkout Button -->
        <TextView
            android:id="@+id/btnCheckout"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Lanjut ke checkout"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/bottomCheckoutBar"
        android:background="@color/guppy_stroke"/>
</RelativeLayout>