<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".menuProfile.AddProductActivity">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarAddProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackAddProduct"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Tambah Varian Produk"
            android:textColor="@color/guppy_text_black"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginEnd="40dp"/>
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/topBarAddProduct"
        android:background="#EEEEEE"/>

    <!-- FORM SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarAddProduct"
        android:layout_above="@id/bottomBarPublish"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="30dp">

            <!-- 1. MEDIA IKAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Media Ikan"
                    android:textColor="@color/guppy_primary"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="15sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(1 Video + 3 Foto)"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- Video Slot -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUploadVideo"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="90dp"
                    android:layout_marginEnd="5dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#E8F5E9"
                    app:strokeColor="@color/guppy_primary"
                    app:strokeWidth="1.5dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivVideoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>

                        <LinearLayout
                            android:id="@+id/layoutVideoPlaceholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="4dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_video_camera"
                                app:tint="@color/guppy_primary"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="+ Video"
                                android:textColor="@color/guppy_primary"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Photo Slot 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUploadPhoto1"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="90dp"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F2F4F5"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivPhotoPreview1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>

                        <LinearLayout
                            android:id="@+id/layoutPhotoPlaceholder1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_image_gallery"
                                app:tint="@color/guppy_text_gray"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Foto 1"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Photo Slot 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUploadPhoto2"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="90dp"
                    android:layout_marginHorizontal="3dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F2F4F5"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivPhotoPreview2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>

                        <LinearLayout
                            android:id="@+id/layoutPhotoPlaceholder2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_image_gallery"
                                app:tint="@color/guppy_text_gray"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Foto 2"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <!-- Photo Slot 3 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardUploadPhoto3"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="90dp"
                    android:layout_marginStart="5dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F2F4F5"
                    app:strokeWidth="0dp"
                    android:clickable="true"
                    android:focusable="true">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivPhotoPreview3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"/>

                        <LinearLayout
                            android:id="@+id/layoutPhotoPlaceholder3"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_image_gallery"
                                app:tint="@color/guppy_text_gray"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Foto 3"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="11sp"/>
                        </LinearLayout>
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Video Compression Yellow Guidance Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF9E6"
                app:strokeColor="#FFE082"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Maksimal video 10 MB. Sistem otomatis mengompresi video untuk kualitas terbaik."
                        android:textColor="#D84315"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="11.5sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. NAMA VARIAN PRODUK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Nama Varian Produk"
                    android:textColor="@color/guppy_primary"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="15sp"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_verified_badge"
                    app:tint="@color/guppy_primary"/>
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etProductName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Red Dragon Delta Grade A+"
                    android:textColorHint="@color/guppy_text_gray"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_medium"
                    android:paddingHorizontal="16dp"
                    android:textSize="13.5sp"
                    android:singleLine="true"/>
            </androidx.cardview.widget.CardView>

            <!-- 3. KATEGORI & STRAIN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Kategori &amp; Strain"
                android:textColor="@color/guppy_primary"
                android:fontFamily="@font/inter_bold"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- Kategori Dropdown -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kategori (Tujuan)"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvSelectCategory"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Ikan Kontes"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:textSize="13sp"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            app:drawableTint="@color/guppy_text_gray"
                            android:clickable="true"
                            android:focusable="true"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Strain Dropdown -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Strain (Varian)"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvSelectStrain"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Mosaic"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:textSize="13sp"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            app:drawableTint="@color/guppy_text_gray"
                            android:clickable="true"
                            android:focusable="true"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- 4. HARGA & KETERSEDIAAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Harga &amp; Ketersediaan"
                android:textColor="@color/guppy_primary"
                android:fontFamily="@font/inter_bold"
                android:textSize="15sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <!-- Harga Jual -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Harga Jual"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp "
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="13sp"/>

                            <EditText
                                android:id="@+id/etProductPrice"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@null"
                                android:hint="150.000"
                                android:textColorHint="@color/guppy_text_gray"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="13.5sp"
                                android:inputType="number"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Satuan Unit -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Satuan (Unit)"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"/>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvSelectUnit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="per pasang"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_medium"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:textSize="13sp"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            app:drawableTint="@color/guppy_text_gray"
                            android:clickable="true"
                            android:focusable="true"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- Stok Tersedia Stepper Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Stok Tersedia"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_medium"
                android:textSize="12sp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:orientation="horizontal">

                    <!-- Minus Button -->
                    <ImageView
                        android:id="@+id/btnMinStock"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="#E0F2F1"
                        android:src="@drawable/fi_rr_cross_small"
                        android:rotation="45"
                        app:tint="@color/guppy_primary"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <!-- Stock Number Display -->
                    <EditText
                        android:id="@+id/etProductStock"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:text="20"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="18sp"
                        android:gravity="center"
                        android:inputType="number"/>

                    <!-- Plus Button -->
                    <ImageView
                        android:id="@+id/btnPlusStock"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="#E0F2F1"
                        android:src="@drawable/fi_rr_cross_small"
                        app:tint="@color/guppy_primary"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. DESKRIPSI PRODUK -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Deskripsi Produk"
                android:textColor="@color/guppy_primary"
                android:fontFamily="@font/inter_bold"
                android:textSize="15sp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="14dp">

                    <EditText
                        android:id="@+id/etProductDescription"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_above="@id/tvDescCharCount"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="Tulis deskripsi kesehatan ikan, keunggulan genetik, dan panduan klaim garansi (Dead on Arrival)..."
                        android:textColorHint="#B0BEC5"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13sp"
                        android:maxLength="1000"/>

                    <TextView
                        android:id="@+id/tvDescCharCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:text="0/1000"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="11sp"/>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- STICKY BOTTOM ACTION BAR -->
    <LinearLayout
        android:id="@+id/bottomBarPublish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="12dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/btnPublishProductBottom"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#00897B"
            android:text="Tambahkan Varian Sekarang"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:gravity="center"
