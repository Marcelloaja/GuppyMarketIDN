<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".menuProfile.CourierSettingsActivity">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarCourierSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackCourierSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Kurir"
                android:textColor="@color/guppy_text_black"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_regular"
                android:text="Atur jasa pengiriman untuk pesananmu"
                android:textColor="@color/guppy_text_gray"
                android:textSize="12.5sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/topBarCourierSettings"
        android:background="#EEEEEE"/>

    <!-- FORM SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader"
        android:layout_above="@id/bottomBarCourierSave"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="30dp">

            <!-- TOP SUMMARY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kurir aktif"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="12.5sp"/>

                            <TextView
                                android:id="@+id/tvActiveCourierCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="4 dari 6 layanan aktif"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="18sp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/guppy_primary"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFastestDeliveryNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pengiriman tercepat: Instan, estimasi 2–4 jam"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="12.5sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 1: LAYANAN KURIR CARD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="LAYANAN KURIR"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_bold"
                android:textSize="11.5sp"
                android:letterSpacing="0.05"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 1. JNE Reguler -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JNE Reguler"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="14.5sp"/>
                            <TextView
                                android:id="@+id/tvPriceJNERegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="estimasi 2–3 hari · mulai Rp 12.000"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchJNERegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:useMaterialThemeColors="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

                    <!-- 2. JNE YES -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JNE YES"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="14.5sp"/>
                            <TextView
                                android:id="@+id/tvPriceJNEYes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="estimasi 1 hari · mulai Rp 25.000"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchJNEYes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:useMaterialThemeColors="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

                    <!-- 3. J&T Express -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="J&amp;T Express"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="14.5sp"/>
                            <TextView
                                android:id="@+id/tvPriceJNT"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="estimasi 2–3 hari · mulai Rp 11.000"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchJNTExpress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:useMaterialThemeColors="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

                    <!-- 4. SiCepat Halu -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SiCepat Halu"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="14.5sp"/>
                            <TextView
                                android:id="@+id/tvPriceSiCepat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="estimasi 1–2 hari · mulai Rp 14.000"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSiCepatHalu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="false"
                            app:useMaterialThemeColors="true"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

                    <!-- 5. GrabExpress Instan -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GrabExpress Instan"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="14.5sp"/>
                            <TextView
                                android:id="@+id/tvPriceGrab"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="estimasi 2–4 jam · mulai Rp 18.000"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchGrabInstant"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            app:useMaterialThemeColors="true"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: KURIR UTAMA CARD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="KURIR UTAMA"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_bold"
                android:textSize="11.5sp"
                android:letterSpacing="0.05"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMainCourier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSelectedMainCourier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JNE Reguler"
                            android:textColor="@color/guppy_text_black"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="14.5sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Dipakai otomatis untuk pesanan baru"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_radio_selected"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 3: PENGATURAN PICKUP CARD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="PENGATURAN PICKUP"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_bold"
                android:textSize="11.5sp"
                android:letterSpacing="0.05"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Pickup Schedule Row -->
                    <LinearLayout
                        android:id="@+id/rowPickupSchedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/guppy_primary"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Jadwal pickup"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="14sp"/>
                            <TextView
                                android:id="@+id/tvPickupSchedule"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Setiap hari, 09.00–16.00"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/guppy_text_gray"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE"/>

                    <!-- Origin Address Row -->
                    <LinearLayout
                        android:id="@+id/rowOriginAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="@color/guppy_primary"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alamat asal paket"
                                android:textColor="@color/guppy_text_black"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="14sp"/>
                            <TextView
                                android:id="@+id/tvPickupAddressSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rumah, Bekasi Selatan"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_regular"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/guppy_text_gray"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- STICKY BOTTOM ACTION BAR -->
    <LinearLayout
        android:id="@+id/bottomBarCourierSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="12dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <TextView
            android:id="@+id/btnSaveCourierSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#124332"
            android:text="Simpan Perubahan"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</RelativeLayout>