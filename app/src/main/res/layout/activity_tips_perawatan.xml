<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".menuProfile.TipsPerawatanActivity">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarTips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#F8F9FA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackTips"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Tips Perawatan"
            android:textColor="@color/guppy_text_black"
            android:textSize="18sp"
            android:gravity="center"/>

        <ImageView
            android:id="@+id/btnSavedBookmarks"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_bookmark_outline"
            android:padding="10dp"
            app:tint="@color/guppy_text_black"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBarTips"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="60dp">

            <!-- SEARCH INPUT BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/search"
                    app:tint="@color/guppy_text_gray"/>

                <EditText
                    android:id="@+id/etSearchTips"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/inter_regular"
                    android:hint="Cari tips perawatan guppy..."
                    android:textColorHint="@color/guppy_text_gray"
                    android:textColor="@color/guppy_text_black"
                    android:paddingStart="10dp"
                    android:singleLine="true"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- CATEGORY TABS (HORIZONTAL SCROLL) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Tab 1: Semua -->
                    <LinearLayout
                        android:id="@+id/tabTipsAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvTabTipsAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Semua"
                            android:textColor="@color/guppy_primary"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp"/>
                        <View
                            android:id="@+id/indicatorTipsAll"
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:background="@color/guppy_primary"/>
                    </LinearLayout>

                    <!-- Tab 2: Kualitas Air -->
                    <LinearLayout
                        android:id="@+id/tabTipsWater"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvTabTipsWater"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kualitas Air"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp"/>
                        <View
                            android:id="@+id/indicatorTipsWater"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/guppy_stroke"/>
                    </LinearLayout>

                    <!-- Tab 3: Nutrisi -->
                    <LinearLayout
                        android:id="@+id/tabTipsNutrition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvTabTipsNutrition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nutrisi"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp"/>
                        <View
                            android:id="@+id/indicatorTipsNutrition"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/guppy_stroke"/>
                    </LinearLayout>

                    <!-- Tab 4: Breeding -->
                    <LinearLayout
                        android:id="@+id/tabTipsBreeding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">
                        <TextView
                            android:id="@+id/tvTabTipsBreeding"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Breeding"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_medium"
                            android:textSize="14sp"
                            android:layout_marginBottom="8dp"/>
                        <View
                            android:id="@+id/indicatorTipsBreeding"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/guppy_stroke"/>
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- FEATURED HERO ARTICLE CARD -->
            <LinearLayout
                android:id="@+id/cardHeroArticle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <!-- Hero Image Banner with Tag -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp">

                    <ImageView
                        android:id="@+id/imgHeroBanner"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/skyblue"/>

                    <!-- Category Badge Tag -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_tag_photo_count"
                        android:backgroundTint="#225741"
                        android:text="KUALITAS AIR"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="10.5sp"
                        android:letterSpacing="0.05"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"/>
                </FrameLayout>

                <!-- Hero Title & Excerpt -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cara menjaga kualitas air untuk guppy kontes"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="20sp"
                        android:lineSpacingExtra="4dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Parameter air yang stabil adalah kunci utama dalam menjaga kesehatan dan keindahan ekor guppy premium Anda."
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="13.5sp"
                        android:lineSpacingExtra="4dp"/>

                    <!-- Meta & Bookmark Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕒 4 MENIT BACA"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="10.5sp"
                            android:letterSpacing="0.05"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="12 OKT 2025"
                            android:textColor="@color/guppy_text_gray"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="10.5sp"
                            android:letterSpacing="0.05"/>

                        <View
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="1dp"/>

                        <ImageView
                            android:id="@+id/btnBookmarkHero"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_bookmark_outline"
                            app:tint="@color/guppy_text_black"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/guppy_stroke"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"/>
            </LinearLayout>

            <!-- LATEST ARTICLES SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Artikel Terbaru"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24 ARTIKEL"
                        android:textColor="@color/guppy_primary"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerLatestArticles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>