<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER: Order ID + Badge + Deadline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSellerOrderNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#GM-20931"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/tvSellerStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="#FFF3E0"
                android:text="Perlu Dikemas"
                android:textColor="#E65100"
                android:fontFamily="@font/inter_bold"
                android:textSize="10.5sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>

            <TextView
                android:id="@+id/tvSellerDeadline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Kirim sebelum 12 Des 17.00"
                android:textColor="#E53935"
                android:fontFamily="@font/inter_regular"
                android:textSize="11.5sp"
                android:gravity="end"/>
        </LinearLayout>

        <!-- BUYER ADDRESS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/guppy_text_gray"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSellerBuyerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Marcello Aja"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="13.5sp"/>

                <TextView
                    android:id="@+id/tvSellerBuyerCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Bekasi Selatan, Kota Bekasi"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="#EEEEEE"/>

        <!-- PRODUCT DETAILS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_image_gallery"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSellerProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Red Dragon Delta"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="14.5sp"/>

                <TextView
                    android:id="@+id/tvSellerProductVariant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="2 pasang (4 ekor)"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvSellerTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Rp 577.000"
                    android:textColor="#124332"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="14sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ACTION FORM FOR PACKING & SHIPPING -->
        <LinearLayout
            android:id="@+id/layoutSellerActionForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- COURIER SELECTION CHIPS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipJne"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_selected"
                    android:backgroundTint="#E0F2F1"
                    android:text="JNE Express"
                    android:textColor="@color/guppy_primary"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="11.5sp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/chipJnt"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_btn_outline_pill_gray"
                    android:text="J&amp;T"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="11.5sp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/chipSicepat"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_btn_outline_pill_gray"
                    android:text="SiCepat"
                    android:textColor="@color/guppy_text_gray"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="11.5sp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"/>
            </LinearLayout>

            <!-- RESI INPUT BOX -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etSellerResiInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Masukkan nomor resi"
                    android:textColorHint="@color/guppy_text_gray"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_bold"
                    android:paddingHorizontal="14dp"
                    android:textSize="13.5sp"
                    android:singleLine="true"/>
            </androidx.cardview.widget.CardView>

            <!-- ACTION BUTTONS: CETAK LABEL & TANDAI DIKIRIM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSellerPrintLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_btn_outline_pill_gray"
                    android:text="Cetak Label"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="13.5sp"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/btnSellerMarkShipped"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_chip_selected"
                    android:backgroundTint="#124332"
                    android:text="Tandai Dikirim"
                    android:textColor="@color/white"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

        </LinearLayout>

        <!-- SHIPPED STATUS BOX (FOR ALREADY SHIPPED ORDERS) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutSellerShippedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8F9FA"
            app:strokeWidth="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSellerShippedCourierResi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SiCepat · SC7723910"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Kurir sedang menuju lokasi"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="13sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnSellerViewResi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lihat Resi"
                    android:textColor="#124332"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="13sp"
                    android:padding="6dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>