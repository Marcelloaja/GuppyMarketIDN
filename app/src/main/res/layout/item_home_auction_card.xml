<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/guppy_stroke"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- IMAGE CONTAINER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="145dp">

            <ImageView
                android:id="@+id/imgAuctionItem"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_image_grid" />

            <!-- LIVE Tag -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_tag_photo_count"
                android:backgroundTint="@color/guppy_red"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_circle_image"
                    android:backgroundTint="@color/white"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textColor="@color/white"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="9sp"/>
            </LinearLayout>

            <!-- Grade Tag -->
            <TextView
                android:id="@+id/tvAuctionItemGrade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_tag_photo_count"
                android:backgroundTint="#CC00897B"
                android:text="Grade A+"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_bold"
                android:textSize="9.5sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>
        </FrameLayout>

        <!-- CONTENT AREA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvAuctionItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Blue Gold Mosaic"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvAuctionItemSeller"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Guppy Nusantara · Bandung"
                android:textColor="@color/guppy_text_gray"
                android:fontFamily="@font/inter_regular"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bid saat ini"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="10sp"/>
                    <TextView
                        android:id="@+id/tvAuctionItemPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Rp 850.000"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="14sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvAuctionItemTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 02:14:35"
                    android:textColor="@color/guppy_red"
                    android:textSize="10.5sp"
                    android:fontFamily="@font/inter_semi_bold"
                    android:background="@drawable/bg_tag_grade"
                    android:backgroundTint="#20E53935"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvAuctionItemBids"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:text="12 penawaran · Ikut Lelang"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:fontFamily="@font/inter_semi_bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>