<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chip_outline"
        android:backgroundTint="@color/guppy_stroke"/>

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Semua Kategori Varian"
            android:textColor="@color/guppy_text_black"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btnCloseCategories"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_circle_image"
            android:backgroundTint="#F0F0F0"
            android:src="@drawable/fi_rr_cross_small"
            android:padding="6dp"
            app:tint="@color/guppy_text_black"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/inter_regular"
        android:text="Pilih varian genetika ikan guppy favorit Anda"
        android:textColor="@color/guppy_text_gray"
        android:textSize="12sp" />

    <!-- Categories Grid RecyclerView (3 Columns) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCategories"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

</LinearLayout>