<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".menuProfile.MyOrdersActivity">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarMyOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FAFAFA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackMyOrders"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:text="Pesanan Saya"
                android:textColor="@color/guppy_text_black"
                android:textSize="18sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/inter_regular"
                android:text="Daftar transaksi pembelian guppy Anda"
                android:textColor="@color/guppy_text_gray"
                android:textSize="12.5sp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/topBarMyOrders"
        android:background="#EEEEEE"/>

    <!-- HORIZONTAL STATUS FILTER TABS -->
    <HorizontalScrollView
        android:id="@+id/scrollTabsMyOrders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/dividerHeader"
        android:background="@color/white"
        android:scrollbars="none"
        android:paddingVertical="10dp"
        android:paddingHorizontal="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Tab 1: Semua -->
            <TextView
                android:id="@+id/tabMyOrderSemua"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_primary"
                android:backgroundTint="#124332"
                android:text="Semua"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_bold"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Tab 2: Menunggu Bayar -->
            <TextView
                android:id="@+id/tabMyOrderMenunggu"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_solid_gray"
                android:text="Menunggu Bayar"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Tab 3: Dikirim -->
            <TextView
                android:id="@+id/tabMyOrderDikirim"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_solid_gray"
                android:text="Dikirim"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Tab 4: Selesai -->
            <TextView
                android:id="@+id/tabMyOrderSelesai"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_solid_gray"
                android:text="Selesai"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:id="@+id/dividerTabs"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/scrollTabsMyOrders"
        android:background="#EEEEEE"/>

    <!-- ORDERS RECYCLER VIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMyOrders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerTabs"
        android:clipToPadding="false"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"/>

    <!-- EMPTY STATE -->
    <TextView
        android:id="@+id/tvEmptyMyOrders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:fontFamily="@font/inter_medium"
        android:text="Belum ada pesanan pada kategori ini."
        android:textColor="@color/guppy_text_gray"
        android:textSize="13.5sp"
        android:visibility="gone"/>

</RelativeLayout>