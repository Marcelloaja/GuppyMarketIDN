<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_marginEnd="16dp"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/containerBgCircle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_circle_image"
        android:backgroundTint="#FCE4EC">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCategoryHome"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/skyblue"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvCategoryNameHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Semua"
        android:textSize="12sp"
        android:fontFamily="@font/inter_semi_bold"
        android:textColor="@color/guppy_text_black"
        android:layout_marginTop="8dp"/>
</LinearLayout>