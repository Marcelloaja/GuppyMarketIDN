<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCategoryHome"
    android:layout_width="wrap_content"
    android:layout_height="42dp"
    android:layout_marginEnd="10dp"
    app:cardCornerRadius="21dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F5F8F6"
    app:strokeColor="@color/guppy_stroke"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCategoryHome"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/skyblue"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageStyle"/>

        <TextView
            android:id="@+id/tvCategoryNameHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Pakan Ikan"
            android:textSize="12.5sp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/guppy_text_black"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>