<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:paddingHorizontal="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvBidAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_image"
        android:backgroundTint="@color/guppy_primary"
        android:text="BG"
        android:textColor="@color/white"
        android:fontFamily="@font/inter_bold"
        android:textSize="14sp"
        android:gravity="center"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBidUserHandle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="bimaguppy"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvHighestTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_photo_count"
                android:backgroundTint="#E0F2F1"
                android:text="Tertinggi"
                android:textColor="@color/guppy_primary"
                android:fontFamily="@font/inter_bold"
                android:textSize="10sp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="visible"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBidTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="2 menit lalu"
            android:textColor="@color/guppy_text_gray"
            android:fontFamily="@font/inter_regular"
            android:textSize="12sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvBidAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 1.275.000"
        android:textColor="@color/guppy_primary"
        android:fontFamily="@font/inter_bold"
        android:textSize="15sp"/>
</LinearLayout>