<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvFarmInitials"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_image"
        android:backgroundTint="@color/guppy_primary"
        android:text="JG"
        android:textColor="@color/white"
        android:gravity="center"
        android:fontFamily="@font/inter_semi_bold"
        android:textSize="16sp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHomeFarmName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jakarta Guppy House"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/guppy_text_black"
            android:textSize="14.5sp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location_pin"
                app:tint="@color/guppy_text_gray"/>
            <TextView
                android:id="@+id/tvHomeFarmDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="2,4 km"
                android:textSize="12sp"
                android:textColor="@color/guppy_text_gray"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/star"
                app:tint="@color/guppy_star"/>
            <TextView
                android:id="@+id/tvHomeFarmRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="4.9"
                android:fontFamily="@font/inter_semi_bold"
                android:textSize="12sp"
                android:textColor="@color/guppy_text_black"/>
            <TextView
                android:id="@+id/tvHomeFarmVariants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="18 varian"
                android:textSize="12sp"
                android:textColor="@color/guppy_text_gray"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnHomeFarmVisit"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_kunjungi_btn"
        android:text="Kunjungi"
        android:textColor="@color/guppy_primary"
        android:fontFamily="@font/inter_semi_bold"
        android:textSize="12.5sp"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>