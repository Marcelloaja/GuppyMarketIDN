<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="175dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/guppy_primary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- Texts & Button (Left Side) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_promo"
                    android:text="HOT PROMO"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Diskon Spesial\nFarm Jakarta"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="1dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Hingga 50% untuk Albino"
                    android:textColor="#E7F3EE"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_regular"/>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_btn_white"
                    android:text="Lihat Promo"
                    android:textColor="@color/guppy_primary"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_bold"
                    android:textAllCaps="false"
                    android:paddingHorizontal="16dp"
                    android:minHeight="0dp"
                    android:minWidth="0dp"/>

            </LinearLayout>

            <!-- Fish Image (Right Side) -->
            <ImageView
                android:id="@+id/imageCarouselItem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.9"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_image_grid" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
