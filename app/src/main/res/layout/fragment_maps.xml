<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ui.Maps">

    <!-- 1. MAPLIBRE GL + OPENSTREETMAP VECTOR MAP CONTAINER -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Interactive MapLibre GL Vector WebView -->
        <WebView
            android:id="@+id/webViewMaps"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating UI Overlays on Top of Map -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Floating Search Bar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSearchContainer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="36dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:id="@+id/iconSearch"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/search"
                        app:tint="#66BB6A"/>

                    <EditText
                        android:id="@+id/etSearchHome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/inter_regular"
                        android:hint="Cari farm atau varian guppy..."
                        android:textColor="@color/guppy_text_black"
                        android:textColorHint="@color/guppy_text_gray"
                        android:paddingStart="12dp"
                        android:singleLine="true"
                        android:textSize="13sp"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/guppy_text_black"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- NAVIGATION MODE HEADER BANNER -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardNavBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="36dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="@color/guppy_primary"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Back / End Nav Button -->
                        <ImageView
                            android:id="@+id/btnEndNav"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_circle_icon_action"
                            android:src="@drawable/ic_chevron_left"
                            android:padding="8dp"
                            app:tint="@color/guppy_text_black"
                            android:clickable="true"
                            android:focusable="true"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvNavInfoTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Menuju Guppy King Farm"
                                android:textColor="@color/white"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/tvNavInfoSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Mengkalkulasi rute..."
                                android:textColor="#E0F2F1"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="11sp"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnStopNavText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_photo_count"
                            android:backgroundTint="@color/guppy_red"
                            android:text="Akhiri"
                            android:textColor="@color/white"
                            android:fontFamily="@font/inter_bold"
                            android:textSize="12sp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <!-- VEHICLE MODE SEGMENTED CONTROL BAR -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_vehicle_segment_container"
                        android:padding="3dp"
                        android:orientation="horizontal">

                        <!-- Mobil Option (Active Default) -->
                        <LinearLayout
                            android:id="@+id/chipModeCar"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_vehicle_active_pill"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/icModeCar"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_mode_car"
                                app:tint="@color/guppy_primary"/>

                            <TextView
                                android:id="@+id/tvModeCar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Mobil"
                                android:textColor="@color/guppy_primary"
                                android:fontFamily="@font/inter_bold"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <!-- Motor Option (Inactive) -->
                        <LinearLayout
                            android:id="@+id/chipModeMotor"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/icModeMotor"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_mode_motor"
                                app:tint="#D0E8DD"/>

                            <TextView
                                android:id="@+id/tvModeMotor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Motor"
                                android:textColor="#D0E8DD"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <!-- Jalan Kaki Option (Inactive) -->
                        <LinearLayout
                            android:id="@+id/chipModeWalk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/icModeWalk"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_mode_walk"
                                app:tint="#D0E8DD"/>

                            <TextView
                                android:id="@+id/tvModeWalk"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Jalan Kaki"
                                android:textColor="#D0E8DD"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="12sp"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Floating Action Controls on Right Side -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_marginTop="100dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- Zoom In / Out Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="80dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/btnZoomIn"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="+"
                            android:textSize="20sp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/guppy_text_black"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/guppy_stroke"/>

                        <TextView
                            android:id="@+id/btnZoomOut"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:text="−"
                            android:textSize="20sp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/guppy_text_black"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- My Location Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMyLocation"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/white"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_my_location"
                        app:tint="@color/guppy_primary"/>
                </androidx.cardview.widget.CardView>

                <!-- Map Layers Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/white">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_map_layers"
                        app:tint="@color/guppy_text_black"/>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </FrameLayout>
    </FrameLayout>

    <!-- 2. DRAGGABLE BOTTOM SHEET ("FARM TERDEKAT") -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheetFarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:shapeAppearanceOverlay="@style/TopRoundedCardStyle"
        app:cardElevation="16dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="0dp"
        app:behavior_peekHeight="190dp"
        app:behavior_hideable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="100dp"> <!-- Padding for bottom nav -->

            <!-- Drag Handle -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_chip_outline"
                android:backgroundTint="@color/guppy_stroke"/>

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_bold"
                    android:text="Farm Terdekat"
                    android:textColor="@color/guppy_text_black"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_grade"
                    android:text="12 farm"
                    android:textColor="@color/guppy_primary"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textSize="12sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"/>
            </LinearLayout>

            <!-- Location Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_map_folded"
                    app:tint="@color/guppy_primary"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/inter_medium"
                    android:text="Lokasi Anda · Jatinegara, Jakarta Timur"
                    android:textColor="@color/guppy_text_black"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="Ubah"
                    android:textColor="@color/guppy_primary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter_regular"
                android:text="Diperbarui 5 menit lalu"
                android:textColor="@color/guppy_text_gray"
                android:textSize="11sp"/>

            <!-- Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Selected: Terdekat -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_green"
                        android:text="📍 Terdekat"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter_semi_bold"
                        android:textSize="12sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp"/>

                    <!-- Unselected: Rating Tertinggi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_outline"
                        android:text="⭐ Rating tertinggi"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"
                        android:layout_marginEnd="8dp"/>

                    <!-- Unselected: Buka sekarang -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_outline"
                        android:text="Buka sekarang"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_medium"
                        android:textSize="12sp"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- FARM ITEM 1 (Highlighted) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/skyblue"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:text="Guppy King Farm"
                                android:textColor="@color/guppy_text_black"
                                android:textSize="15sp"/>

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_verified_badge"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="● Buka · tutup 21.00"
                            android:textColor="#2E7D32"
                            android:textSize="11sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="⭐ 4.9 (318) · 0,8 km · Jatinegara"
                            android:textColor="@color/guppy_text_black"
                            android:textSize="11sp"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_tag_grade"
                                android:text="150+ varian"
                                android:textColor="@color/guppy_primary"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="10sp"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_rounded_unselected"
                                android:text="Breeder"
                                android:textColor="@color/guppy_text_gray"
                                android:fontFamily="@font/inter_medium"
                                android:textSize="10sp"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Send / Navigation FAB Button -->
                    <ImageView
                        android:id="@+id/btnStartNavigation"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="@color/guppy_primary"
                        android:src="@drawable/ic_send_nav"
                        android:padding="10dp"
                        app:tint="@color/white"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FARM ITEM 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/platinumrd"/>
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_bold"
                            android:text="Aquatic Indo"
                            android:textColor="@color/guppy_text_black"
                            android:textSize="15sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_medium"
                            android:text="Tutup · buka besok 08.00"
                            android:textColor="@color/guppy_text_gray"
                            android:textSize="11sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="⭐ 4.7 (96) · 2,4 km · Tebet"
                            android:textColor="@color/guppy_text_black"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Chevron Right Button -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_circle_image"
                        android:backgroundTint="#F0F0F0"
                        android:src="@drawable/fi_rr_angle_small_right"
                        android:padding="6dp"
                        app:tint="@color/guppy_text_black"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
