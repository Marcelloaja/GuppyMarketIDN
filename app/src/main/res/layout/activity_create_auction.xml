<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".menuAuction.CreateAuctionActivity">

    <!-- TOP BAR HEADER -->
    <LinearLayout
        android:id="@+id/topBarCreateAuction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#F8F9FA"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBackCreateAuction"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white_stroke"
            android:src="@drawable/ic_chevron_left"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:text="Buat Lelang Baru"
            android:textColor="@color/guppy_text_black"
            android:textSize="18sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/btnPublishTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Terbitkan"
            android:textColor="@color/guppy_primary"
            android:fontFamily="@font/inter_bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <View
        android:id="@+id/dividerHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/topBarCreateAuction"
        android:background="@color/guppy_stroke"/>

    <!-- FORM SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dividerHeader"
        android:layout_above="@id/bottomBarPublish"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="40dp">

            <!-- 1. UPLOAD PHOTO / VIDEO FRAME -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Foto / Video Ikan Lelang"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardUploadPhoto"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/guppy_primary"
                app:strokeWidth="1.5dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_video_camera"
                        app:tint="@color/guppy_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="+ Upload Foto / Video Ikan"
                        android:textColor="@color/guppy_primary"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="14sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Maksimal 4 foto / 1 video pendek"
                        android:textColor="@color/guppy_text_gray"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="11.5sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. JUDUL LELANG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Judul Lelang"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etAuctionTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:hint="misal: Red Dragon Delta Grade A+ Pair"
                android:textColorHint="@color/guppy_text_gray"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_regular"
                android:paddingHorizontal="14dp"
                android:textSize="13.5sp"
                android:singleLine="true"/>

            <!-- 3. PILIH GALUR VARIAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Galur Varian"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvSelectStrain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:text="Pilih Galur Varian ∨"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:textSize="13.5sp"
                android:clickable="true"
                android:focusable="true"/>

            <!-- 4. HARGA OPEN BID & KELIPATAN BID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open Bid (OB)"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etOpenBidPrice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_bar"
                        android:hint="Rp 200.000"
                        android:textColorHint="@color/guppy_text_gray"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:paddingHorizontal="14dp"
                        android:textSize="13.5sp"
                        android:inputType="number"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelipatan (KB)"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/etBidIncrementPrice"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_bar"
                        android:hint="Rp 25.000"
                        android:textColorHint="@color/guppy_text_gray"
                        android:textColor="@color/guppy_text_black"
                        android:fontFamily="@font/inter_bold"
                        android:paddingHorizontal="14dp"
                        android:textSize="13.5sp"
                        android:inputType="number"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 5. BUYOUT PRICE (OPSIONAL) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Harga Buyout (Opsional)"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etBuyoutPrice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:hint="Rp 1.000.000 (Kosongkan jika tidak ada)"
                android:textColorHint="@color/guppy_text_gray"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="14dp"
                android:textSize="13.5sp"
                android:inputType="number"/>

            <!-- 6. DURASI LELANG CHIPS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Durasi Lelang"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipDuration12"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="12 Jam"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipDuration24"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_selected"
                    android:text="24 Jam"
                    android:textColor="@color/guppy_primary"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginHorizontal="3dp"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/chipDuration48"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_chip_outline"
                    android:text="48 Jam"
                    android:textColor="@color/guppy_text_black"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- 7. DESKRIPSI LELANG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Deskripsi &amp; Garansi Ikan"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/etAuctionDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_search_bar"
                android:gravity="top|start"
                android:hint="Tulis deskripsi kesehatan, umur, spesifikasi ekor, dan garansi..."
                android:textColorHint="@color/guppy_text_gray"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_regular"
                android:padding="12dp"
                android:textSize="13sp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- STICKY BOTTOM ACTION BAR -->
    <LinearLayout
        android:id="@+id/bottomBarPublish"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="12dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/btnPublishBottom"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_primary"
            android:text="Terbitkan Lelang Sekarang"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="15sp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@id/bottomBarPublish"
        android:background="@color/guppy_stroke"/>

</RelativeLayout>