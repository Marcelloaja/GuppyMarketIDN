<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Drag Handle Bar -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#D1D5DB"/>

    <!-- Header Row: Title & Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="@font/inter_bold"
            android:text="Tambah Metode Pembayaran"
            android:textColor="@color/guppy_text_black"
            android:textSize="18sp"/>

        <ImageView
            android:id="@+id/btnCloseBottomSheet"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_image"
            android:backgroundTint="#F3F4F6"
            android:src="@drawable/fi_rr_cross_small"
            app:tint="@color/guppy_text_black"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:text="Pilih jenis lalu isi data rekening atau e-wallet Anda."
        android:textColor="@color/guppy_text_gray"
        android:textSize="12.5sp"/>

    <!-- Segmented Type Selector Pills (Rekening Bank vs E-wallet) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F8F9FA"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="3dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabTypeBank"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="#124332"
                android:text="Rekening Bank"
                android:textColor="@color/white"
                android:fontFamily="@font/inter_bold"
                android:textSize="13sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabTypeEWallet"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="E-wallet"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_medium"
                android:textSize="13sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Field 1: Penyedia Dropdown -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Penyedia"
        android:textColor="@color/guppy_text_black"
        android:fontFamily="@font/inter_bold"
        android:textSize="13sp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/tvSelectProvider"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Pilih bank"
            android:textColor="@color/guppy_text_gray"
            android:fontFamily="@font/inter_regular"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:textSize="13sp"
            android:drawableEnd="@drawable/ic_chevron_right"
            app:drawableTint="@color/guppy_text_gray"
            android:clickable="true"
            android:focusable="true"/>
    </androidx.cardview.widget.CardView>

    <!-- Field 2: Nama pemilik rekening -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Nama pemilik rekening"
        android:textColor="@color/guppy_text_black"
        android:fontFamily="@font/inter_bold"
        android:textSize="13sp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <EditText
            android:id="@+id/etAccountOwnerName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@null"
            android:hint="Contoh: Marcello Aja"
            android:textColorHint="@color/guppy_text_gray"
            android:textColor="@color/guppy_text_black"
            android:fontFamily="@font/inter_medium"
            android:paddingHorizontal="14dp"
            android:textSize="13sp"
            android:singleLine="true"/>
    </androidx.cardview.widget.CardView>

    <!-- Field 3A: Nomor rekening (For Bank & Standard E-Wallet) -->
    <LinearLayout
        android:id="@+id/layoutAccountNumberContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Nomor rekening"
            android:textColor="@color/guppy_text_black"
            android:fontFamily="@font/inter_bold"
            android:textSize="13sp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/etAccountNumber"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Masukkan nomor rekening"
                android:textColorHint="@color/guppy_text_gray"
                android:textColor="@color/guppy_text_black"
                android:fontFamily="@font/inter_bold"
                android:paddingHorizontal="14dp"
                android:textSize="13sp"
                android:inputType="number"
                android:singleLine="true"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hanya angka, tanpa spasi atau tanda hubung."
            android:textColor="@color/guppy_text_gray"
            android:fontFamily="@font/inter_regular"
            android:textSize="11.5sp"/>
    </LinearLayout>

    <!-- Field 3B: Upload Foto QRIS Card (For QRIS Provider) -->
    <LinearLayout
        android:id="@+id/layoutQrisUploadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Foto Barcode QRIS Toko"
            android:textColor="@color/guppy_text_black"
            android:fontFamily="@font/inter_bold"
            android:textSize="13sp"/>

        <androidx.cardview.widget.CardView
            android:id="@+id/cardUploadQris"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="6dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8F9FA"
            app:strokeColor="#E2E8F0"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivQrisPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/layoutQrisPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_verified_badge"
                        app:tint="@color/guppy_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="+ Upload Barcode QRIS"
                        android:textColor="@color/guppy_primary"
                        android:fontFamily="@font/inter_bold"
                        android:textSize="13sp"/>
                </LinearLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Green Verification Notice Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F8F9FA"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Rekening akan diverifikasi otomatis sebelum dapat digunakan untuk pencairan saldo."
            android:textColor="#2E7D32"
            android:fontFamily="@font/inter_medium"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp"/>
    </androidx.cardview.widget.CardView>

    <!-- Field 4: Jadikan metode utama Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Jadikan metode utama"
            android:textColor="@color/guppy_text_black"
            android:fontFamily="@font/inter_bold"
            android:textSize="14sp"/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchSetMainPayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            app:useMaterialThemeColors="true"/>
    </LinearLayout>

    <!-- Bottom Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelBottomSheet"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:background="@drawable/bg_btn_outline_pill_gray"
            android:text="Batal"
            android:textColor="@color/guppy_text_black"
            android:fontFamily="@font/inter_bold"
            android:textSize="14.5sp"
            android:gravity="center"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/btnSaveBottomSheet"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:background="@drawable/bg_chip_selected"
            android:backgroundTint="#124332"
            android:text="Simpan"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="14.5sp"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>